// CrossReach — Multi-tenant cross-border customer acquisition platform
// Prisma schema: defines tenants, channels, unified customer profiles, conversations, messages

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Multi-tenant ──────────────────────────────────────────────────────────

model Tenant {
  id        String       @id @default(cuid())
  name      String
  plan      Plan         @default(STARTER)
  status    TenantStatus @default(TRIAL)
  apiKey    String       @unique @default(cuid())
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  users         User[]
  channels      Channel[]
  customers     Customer[]
  conversations Conversation[]
  skillGroups   SkillGroup[]
  routingRules  RoutingRule[]
  leadSources   LeadSource[]
  campaigns     Campaign[]
  sequences     Sequence[]
  aiContentTemplates AIContentTemplate[]
  connectAccounts ConnectAccount[]
  outreachJobs  OutreachJob[]
  websets       Webset[]
  websetItems   WebsetItem[]
  discoveryJobs DiscoveryJob[]
  creditBalance CreditBalance?
  creditTransactions CreditTransaction[]
  usageEvents   UsageEvent[]
  stripeCustomers StripeCustomer[]
  crmIntegrations CrmIntegration[]
  webhookEvents  WebhookEvent[]
  paymentEvents  PaymentEvent[]

  @@map("tenants")
}

// ── Billing: Credit Balance + Ledger + Usage Metering ───────────────────────
// Mirrors Revor's credit-based pricing model: each plan grants monthly credits
// (300 free / 5000 starter / 12000 scale / 30000 pro) that are consumed by
// discovery, enrichment, and outreach actions. Purchased credits never expire
// and top up the balance on top of the monthly grant.

model CreditBalance {
  id            String   @id @default(cuid())
  tenantId      String   @unique
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Purchased credits (never expire; only decremented by consumption)
  purchased     Int      @default(0)
  // Granted credits for the current billing cycle (reset on cycle rollover)
  granted       Int      @default(0)
  // Total consumed across the current cycle (for quota display + dashboards)
  consumedThisCycle Int  @default(0)
  // Start of the current monthly billing cycle (UTC midnight on the 1st)
  cycleStartedAt DateTime @default(now())
  cycleEndsAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("credit_balances")
}

model CreditTransaction {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type        CreditTransactionType
  // Credit delta (positive for grant/top-up/refund, negative for consumption)
  amount      Int
  // Running balance after this transaction (purchased + granted)
  balanceAfter Int
  // What resource triggered this charge (webset item, outreach send, etc.)
  resource    UsageResourceType?
  // Free-form context: { jobId, websetId, channel, action, reason }
  description String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([tenantId])
  @@index([tenantId, type])
  @@index([tenantId, createdAt])
  @@map("credit_transactions")
}

enum CreditTransactionType {
  GRANT      // monthly plan grant at cycle start
  TOP_UP     // purchased credit pack
  CONSUME    // deduction for a metered action
  REFUND     // credit returned (failed action, cancelled job)
  ADJUST     // manual adjustment (support / dispute resolution)
}

model UsageEvent {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  resource    UsageResourceType
  // Credits charged for this single event
  credits     Int
  // Linked entity IDs (nullable: not every event is tied to a job/webset)
  jobId       String?
  websetId    String?
  // Dimensional breakdown for metering dashboards (channel, action, kind)
  dimensions  Json?
  createdAt   DateTime @default(now())

  @@index([tenantId])
  @@index([tenantId, resource])
  @@index([tenantId, createdAt])
  @@map("usage_events")
}

enum UsageResourceType {
  WEBSET_ITEM      // one discovered prospect in a webset
  OUTREACH_SEND    // one email/whatsapp/linkedin outbound send
  RESEARCH         // one public-web research query batch
  CONTACT_FIND     // one decision-maker contact lookup
  AI_GENERATE      // one AI content generation call
}

enum Plan {
  STARTER
  GROWTH
  PRO
  ENTERPRISE
}

enum TenantStatus {
  TRIAL
  ACTIVE
  SUSPENDED
}

model User {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email     String   @unique
  name      String
  role      UserRole @default(AGENT)
  // How this user authenticates. PASSWORD = email + bcrypt hash below;
  // GOOGLE = reserved for OAuth sign-in (no password stored).
  authProvider AuthProvider @default(PASSWORD)
  // bcrypt hash. Null for GOOGLE-provided identities.
  password  String?
  // Reserved for Google OAuth — the Google account's stable subject id.
  googleId  String?  @unique
  // Routing: agent skills (e.g. ["english", "presales"]) and availability
  skills    String[] @default([])
  isOnline  Boolean  @default(true)
  // Round-robin cursor (incremented each assignment, mod agent count)
  rrCursor  Int      @default(0)
  createdAt DateTime @default(now())

  assignedConversations Conversation[] @relation("AgentAssignments")
  skillGroups           SkillGroup[]
  routingRules          RoutingRule[]   @relation("RuleTargetAgent")

  @@index([tenantId])
  @@map("users")
}

enum AuthProvider {
  PASSWORD
  GOOGLE
}

enum UserRole {
  ADMIN
  MANAGER
  AGENT
}

// ── Channel Configuration ─────────────────────────────────────────────────

model Channel {
  id       String      @id @default(cuid())
  tenantId String
  tenant   Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type     ChannelType
  name     String
  // Channel-specific config: phone_number_id, access_token, verify_token, etc.
  config   Json
  isActive Boolean     @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  conversations Conversation[]
  campaigns     Campaign[]
  sequences     Sequence[]
  sequenceSteps SequenceStep[]

  @@unique([tenantId, type])
  @@index([tenantId])
  @@map("channels")
}

enum ChannelType {
  WHATSAPP
  INSTAGRAM
  MESSENGER
  LINE
  TELEGRAM
  EMAIL
  WEB_CHAT
  LINKEDIN
}

// ── Unified Customer Profile (CDP) ────────────────────────────────────────

model Customer {
  id         String         @id @default(cuid())
  tenantId   String
  tenant     Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // External ID from the source channel (e.g. WhatsApp phone number, IG PSID)
  externalId String
  name       String?
  email      String?
  phone      String?
  avatarUrl  String?
  source     String?
  tags       String[]
  stage      CustomerStage  @default(NEW)
  attributes Json?
  lastSeenAt DateTime?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  conversations       Conversation[]
  messages            Message[]
  campaignRecipients  CampaignRecipient[]
  sequenceEnrollments SequenceEnrollment[]

  @@unique([tenantId, externalId])
  @@index([tenantId])
  @@index([tenantId, stage])
  @@map("customers")
}

enum CustomerStage {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL
  WON
  LOST
}

// ── Conversations & Messages ──────────────────────────────────────────────

model Conversation {
  id           String             @id @default(cuid())
  tenantId     String
  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId   String
  customer     Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  channelId    String
  channel      Channel            @relation(fields: [channelId], references: [id])
  status       ConversationStatus @default(OPEN)
  assigneeId   String?
  assignee     User?              @relation("AgentAssignments", fields: [assigneeId], references: [id])
  lastMessageAt DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  messages Message[]

  @@index([tenantId])
  @@index([customerId])
  @@index([assigneeId])
  @@index([tenantId, status])
  @@map("conversations")
}

enum ConversationStatus {
  OPEN
  PENDING
  RESOLVED
}

model Message {
  id             String          @id @default(cuid())
  tenantId       String
  conversationId String
  conversation   Conversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  customerId     String
  customer       Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  direction      MessageDirection
  type           MessageType     @default(TEXT)
  // Unified content: { text: "..." } or { mediaId: "...", caption: "..." } etc.
  content        Json
  // Original raw payload from the channel (for debugging / replay)
  rawPayload     Json?
  status         MessageStatus   @default(SENT)
  createdAt      DateTime        @default(now())

  @@index([conversationId])
  @@index([customerId])
  @@index([tenantId])
  @@index([tenantId, direction])
  @@map("messages")
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageType {
  TEXT
  IMAGE
  AUDIO
  VIDEO
  DOCUMENT
  LOCATION
  TEMPLATE
  INTERACTIVE
  SYSTEM
}

enum MessageStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

// ── Smart Routing ─────────────────────────────────────────────────────────

model SkillGroup {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  skills    String[] @default([])
  members   User[]
  createdAt DateTime @default(now())

  @@index([tenantId])
  @@map("skill_groups")
}

model RoutingRule {
  id          String       @id @default(cuid())
  tenantId    String
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  priority    Int          @default(100) // lower = evaluated first
  matchType   MatchType
  matchValue  String       // e.g. "WHATSAPP", "vip", "facebook_lead"
  strategy    AssignStrategy
  targetAgentId String?
  targetAgent User?        @relation("RuleTargetAgent", fields: [targetAgentId], references: [id])
  targetSkillGroupId String?
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())

  @@index([tenantId])
  @@index([tenantId, priority])
  @@map("routing_rules")
}

enum MatchType {
  CHANNEL_TYPE // match by conversation channel type
  CUSTOMER_TAG // match by customer tag
  KEYWORD      // match by inbound message keyword
  SOURCE       // match by customer source (e.g. facebook_lead)
  LANGUAGE     // match by customer language attribute
  CATCH_ALL    // default fallback rule
}

enum AssignStrategy {
  ROUND_ROBIN  // cycle through available agents in a group
  LEAST_LOAD   // assign to agent with fewest open conversations
  DEDICATED    // always assign to targetAgentId
  SKILL_BASED  // match agents by skills in a skill group
}

// ── Growth / 拓客自动化 ────────────────────────────────────────────────────

model LeadSource {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  platform    LeadPlatform
  name        String
  // Webhook verification token for this lead source
  verifyToken String
  // Config: form_id, page_id, ad_account_id, etc.
  config      Json
  // Auto-enroll new leads into this sequence
  autoSequenceId String?
  // Welcome template to send immediately on lead arrival
  welcomeTemplate  String?
  welcomeLanguage  String? @default("en_US")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([tenantId])
  @@map("lead_sources")
}

enum LeadPlatform {
  FACEBOOK
  TIKTOK
  GOOGLE
  CUSTOM
}

model Campaign {
  id           String         @id @default(cuid())
  tenantId     String
  tenant       Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  channelId    String
  channel      Channel        @relation(fields: [channelId], references: [id])
  templateName String
  language     String         @default("en_US")
  components   Json?
  // Recipient filter: { stage: "NEW", tags: ["vip"], source: "facebook_lead" }
  filter       Json
  status       CampaignStatus @default(DRAFT)
  totalRecipients Int         @default(0)
  sentCount    Int            @default(0)
  failedCount  Int            @default(0)
  createdAt    DateTime       @default(now())
  startedAt    DateTime?
  completedAt  DateTime?

  recipients   CampaignRecipient[]

  @@index([tenantId])
  @@map("campaigns")
}

enum CampaignStatus {
  DRAFT
  RUNNING
  COMPLETED
  PAUSED
}

model CampaignRecipient {
  id          String   @id @default(cuid())
  campaignId  String
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  tenantId    String
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  status      CampaignRecipientStatus @default(PENDING)
  externalMessageId String?
  sentAt      DateTime?
  error       String?
  createdAt   DateTime @default(now())

  @@index([campaignId])
  @@index([customerId])
  @@map("campaign_recipients")
}

enum CampaignRecipientStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

model Sequence {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  description String?
  // Default channel; individual steps can override via step.channelId
  channelId   String?
  channel     Channel?  @relation(fields: [channelId], references: [id])
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  steps       SequenceStep[]
  enrollments SequenceEnrollment[]

  @@index([tenantId])
  @@map("sequences")
}

model SequenceStep {
  id          String   @id @default(cuid())
  sequenceId  String
  sequence    Sequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  stepNumber  Int      // 1-based step order
  // Delay before this step fires (relative to previous step completion)
  delayMinutes Int

  // ── Cross-channel orchestration ──────────────────────────────────────
  // Each step can target a different channel. Falls back to sequence.channelId.
  channelId   String?
  channel     Channel? @relation(fields: [channelId], references: [id])
  // What this step does: send a WhatsApp template, LinkedIn like, email, etc.
  actionType  StepActionType @default(SEND_TEMPLATE)

  // ── Content (used when actionType = SEND_TEMPLATE / SEND_EMAIL) ───────
  templateName String?
  language     String  @default("en_US")
  components   Json?
  // For email steps: subject + body (rendered via AI or static)
  emailSubject String?
  emailBody    String?
  // For LinkedIn action steps: target profile URL or search query
  linkedinTarget String?

  // ── AI generation (when actionType = SEND_AI_OUTREACH) ───────────────
  // Reference to a prompt template that produces personalized content
  aiTemplateId String?
  aiTemplate   AIContentTemplate? @relation(fields: [aiTemplateId], references: [id])

  // Stop sequence if customer has replied on ANY channel by step due time
  stopIfReplied Boolean @default(true)
  createdAt   DateTime @default(now())

  enrollmentsDue SequenceEnrollment[] @relation("EnrollmentCurrentStep")

  @@index([sequenceId])
  @@map("sequence_steps")
}

enum StepActionType {
  SEND_TEMPLATE      // WhatsApp/Messenger template message
  SEND_AI_OUTREACH   // AI-generated personalized outreach
  SEND_EMAIL         // Plain email (subject + body)
  LINKEDIN_LIKE      // Engage with prospect's recent posts
  LINKEDIN_CONNECT   // Send connection request with note
  LINKEDIN_MESSAGE   // Send a LinkedIn DM
  WAIT               // Pure delay, no action (used for spacing)
}

// ── AI Outreach Content Templates ─────────────────────────────────────────
// Stores the prompt + variables used to generate personalized outreach.
model AIContentTemplate {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  // Channel this template is optimized for (affects length/tone)
  channel     ChannelType
  // System prompt with {{variables}} (e.g. {{prospect_name}}, {{company}}, {{pain_point}})
  systemPrompt String
  // User prompt template (the actual generation instruction)
  userPrompt   String
  // Default language for generated content
  language     String  @default("en_US")
  // Max tokens for the generated message
  maxTokens    Int     @default(200)
  createdAt    DateTime @default(now())

  sequenceSteps SequenceStep[]

  @@index([tenantId])
  @@map("ai_content_templates")
}

model SequenceEnrollment {
  id          String   @id @default(cuid())
  tenantId    String
  sequenceId  String
  sequence    Sequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  currentStepId String?
  currentStep SequenceStep? @relation("EnrollmentCurrentStep", fields: [currentStepId], references: [id])
  status      EnrollmentStatus @default(ACTIVE)
  enrolledAt  DateTime @default(now())
  nextStepAt  DateTime?
  completedAt DateTime?

  @@index([sequenceId])
  @@index([customerId])
  @@index([tenantId, status])
  @@index([nextStepAt])
  @@map("sequence_enrollments")
}

enum EnrollmentStatus {
  ACTIVE     // steps still pending
  COMPLETED  // all steps executed
  STOPPED    // customer replied or manually stopped
}

// ── Connect Accounts (对标 Revor connected sending accounts) ──────────────
// A "sending account" = a connected email inbox, LinkedIn session, or
// WhatsApp number that the platform uses to send outbound outreach.
// Revor's model: connect once, then dispatch outreach tasks to it.

model ConnectAccount {
  id        String             @id @default(cuid())
  tenantId  String
  tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Which channel this account can send on
  channel   ConnectChannelType
  name      String
  // Account status — mirrors Revor's "reconnect_required" error code
  status    ConnectAccountStatus @default(ACTIVE)
  // Channel-specific config stored as JSON:
  //   email    → { smtpHost, smtpPort, smtpUser, smtpPass, fromAddress, fromName }
  //   whatsapp → { phoneNumberId, accessToken, wabaId, phoneNumber }
  //   linkedin → { sessionCookie, profileUrl } (Playwright session)
  config    Json
  lastUsedAt DateTime?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  outreachJobs OutreachJob[]

  // A tenant may connect multiple EMAIL inboxes (round-robin warm-up pool);
  // inbox names must be unique so the same box can't be added twice.
  // LinkedIn / WhatsApp stay single-account per tenant (enforced in service).
  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([tenantId, channel])
  @@map("connect_accounts")
}

enum ConnectChannelType {
  EMAIL
  LINKEDIN
  WHATSAPP
}

enum ConnectAccountStatus {
  ACTIVE             // ready to send
  RECONNECT_REQUIRED // session expired / token revoked
  DISABLED           // manually disabled by tenant
}

// ── Outreach Jobs (对标 Revor POST /api/v1/outreach/dispatches) ───────────
// A single outreach task: one email, one LinkedIn action, or one WhatsApp
// message. Created via the dispatch API, executed asynchronously, then
// polled via GET /api/v1/outreach/jobs/{id}.

model OutreachJob {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Which connected sending account executes this job
  connectAccountId String?
  connectAccount   ConnectAccount? @relation(fields: [connectAccountId], references: [id], onDelete: SetNull)

  // Revor-style fields
  action    OutreachAction @default(OUTREACH_DISPATCH)
  channel   ConnectChannelType
  status    OutreachJobStatus @default(QUEUED)

  // Recipient info (channel-specific):
  //   email    → { address, name? }
  //   linkedin → { profileUrl }
  //   whatsapp → { phone }
  recipient Json
  // Message content (channel-specific):
  //   email    → { subject, text?, html?, attachments? }
  //   linkedin → { text?, attachments? }
  //   whatsapp → { text?, attachments? }
  content   Json
  // Optional metadata from the integration (e.g. source campaign, sequence step)
  metadata  Json?

  // Scheduling & execution timeline
  scheduledAt  DateTime?
  startedAt    DateTime?
  finishedAt   DateTime?
  attemptCount Int       @default(0)
  nextAttemptAt DateTime?
  // Min interval between tasks on the same channel/account (Revor: 60-86400s)
  minIntervalSeconds Int @default(60)

  // Result on success (Revor: { resolvedAction, messageId, status })
  result    Json?
  // Error on failure (Revor: { code, message, retryable })
  error     Json?

  // Idempotency key to prevent duplicate dispatches
  idempotencyKey String? @unique

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([connectAccountId])
  @@index([tenantId, status])
  @@index([status, scheduledAt])
  @@map("outreach_jobs")
}

enum OutreachAction {
  OUTREACH_DISPATCH      // send a message/invitation (email/linkedin/whatsapp)
  OUTREACH_LINKEDIN_POST_LIKE // like a prospect's relevant LinkedIn post
}

enum OutreachJobStatus {
  QUEUED     // created, waiting to run
  SCHEDULED  // scheduled for a future time
  RUNNING    // currently executing
  SUCCEEDED  // completed successfully
  FAILED     // execution failed
  CANCELLED  // cancelled by user or system
}

// ── Discovery: Prospect Lists + Research + Contacts (对标 Revor MCP) ────────
// Mirrors Revor's async discovery pipeline:
//   revor_create_webset  → Webset + preparation DiscoveryJob
//   revor_research_public_web → DiscoveryJob (PUBLIC_RESEARCH)
//   revor_find_contacts  → DiscoveryJob (FIND_CONTACTS)
//   revor_get_job / revor_cancel_job → poll / cancel DiscoveryJob

model Webset {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  // COMPANY = find companies matching the ICP; PERSON = find decision-makers
  targetKind  WebsetTargetKind
  // Natural-language ICP + structured filters (region, industry, role, size…)
  criteria    Json
  status      WebsetStatus @default(PREPARING)
  // How many results were/are requested (tier-bounded, never silently reduced)
  requestedCount Int @default(25)
  // Discovered item count (updated as the preparation job produces results)
  itemCount   Int      @default(0)
  // The async job that prepares this webset's results
  preparationJobId String?
  preparationJob  DiscoveryJob? @relation(fields: [preparationJobId], references: [id], onDelete: SetNull)
  items       WebsetItem[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
  @@map("websets")
}

enum WebsetTargetKind {
  COMPANY
  PERSON
}

enum WebsetStatus {
  PREPARING   // discovery in progress
  READY       // results available
  FAILED
}

model WebsetItem {
  id          String   @id @default(cuid())
  websetId    String
  webset      Webset   @relation(fields: [websetId], references: [id], onDelete: Cascade)
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // Ranking position (lower = better match)
  rank        Int
  // Company or person fields (Revor "compact/standard/full" detail modes)
  data        Json
  // 0–100 match confidence
  matchScore  Float?
  // Provisional while discovery is still running (Revor marks early results)
  isProvisional Boolean @default(true)
  createdAt   DateTime @default(now())

  @@index([websetId])
  @@index([tenantId])
  @@map("webset_items")
}

model DiscoveryJob {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // What kind of discovery operation this job runs
  kind      DiscoveryJobKind
  status    DiscoveryJobStatus @default(QUEUED)
  // Original request parameters (ICP, queries, domain, positions…)
  input     Json
  // Result payload on success (research findings / contact list / webset summary)
  result    Json?
  // Credit settlement info (Revor: { charged_credits, … })
  billing   Json?
  // { code, message } on failure
  error     Json?
  // Polling hint returned to the client (Revor next_action: retry_after_ms + arguments)
  nextAction Json?
  startedAt  DateTime?
  finishedAt DateTime?
  createdAt DateTime @default(now())

  websets   Webset[]  // websets whose preparation this job owns

  @@index([tenantId])
  @@index([tenantId, status])
  @@map("discovery_jobs")
}

enum DiscoveryJobKind {
  WEBSET_PREPARATION
  PUBLIC_RESEARCH
  FIND_CONTACTS
}

enum DiscoveryJobStatus {
  QUEUED     // created, waiting to run
  RUNNING    // being processed
  SUCCEEDED  // result + billing ready
  FAILED     // failed, includes public error code
  CANCELLED  // cancelled by user
}

// ── Stripe Billing Integration ──────────────────────────────────────────────
// Links a Stripe Customer to a CrossReach tenant. Used by Checkout sessions
// and recurring-subscription webhooks to reconcile payments into credits.

model StripeCustomer {
  id              String   @id @default(cuid())
  tenantId        String   @unique
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  stripeCustomerId String?
  status          String   @default("created") // created | paid | trialing | past_due | cancelled
  lastSessionId   String?
  lastPlanId      String?
  metadata        Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("stripe_customers")
}

// ── Payment events (ledger from Stripe or other PSPs) ──────────────────────

model PaymentEvent {
  id               String   @id @default(cuid())
  tenantId         String
  tenant           Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  provider         String   // STRIPE | TEST
  providerEventId  String?
  eventKind        String   // CHECKOUT_COMPLETE | INVOICE_PAID | INVOICE_FAILED | TOPUP
  amount           Int      @default(0) // in provider minor units (cents)
  currency         String   @default("usd")
  success          Boolean  @default(false)
  metadata         Json?
  createdAt        DateTime @default(now())

  @@index([tenantId])
  @@index([tenantId, createdAt])
  @@map("payment_events")
}

// ── CRM integrations (HubSpot / Salesforce / Notion) ───────────────────────
// Maps a CRM object id → CrossReach tenant, enabling inbound webhook routing.

model CrmIntegration {
  id         String  @id @default(cuid())
  tenantId   String
  tenant     Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  crm        String  // HUBSPOT | SALESFORCE | NOTION
  externalId String  // deal/contact id in the CRM
  active     Boolean @default(true)
  config     Json?   // webhook signing secret, portal id, etc.
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([crm, externalId])
  @@index([tenantId])
  @@map("crm_integrations")
}

// ── Inbound CRM webhook event log ──────────────────────────────────────────

model WebhookEvent {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  source      String    // HUBSPOT | SALESFORCE | NOTION
  externalId  String
  kind        String    // deal.created | contact.updated | ...
  payload     Json?
  rawPayload  Json?
  processed   Boolean   @default(false)
  processedAt DateTime?
  retryCount  Int       @default(0)
  metadata    Json?
  createdAt   DateTime  @default(now())

  @@index([tenantId])
  @@index([tenantId, source, processed])
  @@index([tenantId, createdAt])
  @@map("webhook_events")
}

// ── Email deliverability: tracking tokens + delivery events ─────────────────
// One token per send: it powers the open pixel, click-through redirect,
// unsubscribe, and the custom SMTP header that bounce webhooks echo back so we
// can attribute a bounce/complaint to the exact send (and account, for health).

model EmailTrackingToken {
  id          String    @id @default(cuid())
  // Single-use opaque token; also placed in the `X-CrossReach-Token` SMTP header
  token       String    @unique
  tenantId    String
  // The connect-account that sent this — drives quota counters + health
  accountId   String?
  // Link back to the outreach job / customer for dashboards + stopIfReplied
  jobId       String?
  customerId  String?
  recipient   String
  messageId   String?
  unsubscribed Boolean  @default(false)
  createdAt   DateTime  @default(now())
  expiresAt   DateTime?

  @@index([tenantId, createdAt])
  @@map("email_tracking_tokens")
}

enum EmailEventType {
  SENT
  DELIVERED
  OPENED
  CLICKED
  BOUNCED_SOFT
  BOUNCED_HARD
  COMPLAINED
  UNSUBSCRIBED
}

model EmailEvent {
  id         String         @id @default(cuid())
  tenantId   String
  accountId  String?
  // Non-null when the event is attributable to a tracked send
  trackToken String?
  type       EmailEventType
  recipient  String?
  messageId  String?
  smtpCode   Int?
  detail     String?
  createdAt  DateTime       @default(now())

  // A token's OPENED/CLICKED/complaint fire repeatedly — keep ONE row per kind.
  @@unique([trackToken, type])
  @@index([tenantId, createdAt])
  @@index([accountId, type])
  @@index([recipient])
  @@map("email_events")
}
