# ── Database (Neon serverless Postgres) ─────────────────────────────
# Copy your connection strings from the Neon console (Dashboard → Connect).
# Two options:
#
# 1) DIRECT endpoint (recommended for this long-running server + for CLI):
#      DATABASE_URL="postgresql://user:password@ep-xxxx-xxxx.region.aws.neon.tech/crossreach?sslmode=require"
#
# 2) POOLED endpoint (PgBouncer/transaction pooler — good when many serverless
#    instances connect): put the pooled URL in DATABASE_URL with ?pgbouncer=true
#    and the DIRECT URL in DIRECT_URL so prisma db push/migrate don't go through
#    the pooler:
#      DATABASE_URL="postgresql://user:password@ep-xxxx-xxxx-pooler.region.aws.neon.tech/crossreach?sslmode=require&pgbouncer=true"
#      DIRECT_URL="postgresql://user:password@ep-xxxx-xxxx.region.aws.neon.tech/crossreach?sslmode=require"
#
# Neon needs TLS: keep `sslmode=require`. Don't commit real credentials — .env
# is gitignored.
DATABASE_URL="postgresql://user:password@localhost:5432/crossreach?schema=public"
# Set to the Neon DIRECT endpoint when DATABASE_URL uses the pooled endpoint.
# Leave empty otherwise (Prisma falls back to DATABASE_URL for db push/migrate).
DIRECT_URL=

# ── Server ────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
REDIS_URL=redis://localhost:6379

# ── Auth (self-serve signup / login) ──────────────────────
# JWT signing secret — MUST be a long random value in production
# (e.g. `openssl rand -hex 32`). The dev fallback is refused in production.
AUTH_JWT_SECRET=replace-with-openssl-rand-hex-32
# Dashboard session lifetime in days
AUTH_SESSION_TTL_DAYS=30

# ── WhatsApp Business Cloud API ──────────────────────────
# Get these from https://developers.facebook.com/apps/ → your app → WhatsApp
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=your_verify_token_here
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v18.0

# ── Meta App (for webhook signature verification) ────────
META_APP_SECRET=

# ── AI content generation (optional — falls back to templates if unset) ──
# OpenRouter as relay (中转站): single key routes to many models and takes
# priority over the direct providers below. Key: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-4o-mini

# Legacy direct OpenAI-compatible provider (only used when no OpenRouter key)
OPENAI_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# ── Internal IM team alerts (enterprise wechat / feishu / dingtalk) ──────
# Configure at least one group-bot webhook to receive operational alerts.
#   WeCom robot:  https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=...
#   Feishu robot: https://open.feishu.cn/open-apis/bot/v2/hook/...
#   DingTalk robot: https://oapi.dingtalk.com/robot/send?access_token=...
# (DingTalk robots using "加签" auth also need DINGTALK_SECRET.)
WECOM_WEBHOOK_URL=
FEISHU_WEBHOOK_URL=
DINGTALK_WEBHOOK_URL=
DINGTALK_SECRET=

# ── Stripe billing (optional — checkout/webhook endpoints error cleanly if unset) ──
# Keys: https://dashboard.stripe.com/test/apikeys
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...   (endpoint signing secret for /webhooks/stripe)

# ── Creem billing — second PSP for FIXED credit packs (充值包) ───────────────
# Creem runs alongside Stripe: it only sells the one-time credit packs defined
# in CREEM_TOPUP_PACKS below. Arbitrary amounts + subscriptions stay on Stripe.
#   Keys/test products: https://dashboard.creem.io/developers  (API key) and
#   Products tab → "Copy ID" for each product id.
#   Webhook secret: Developers → Webhooks → the signing secret (for
#   POST /webhooks/creem, header `creem-signature`, HMAC-SHA256 raw body).
# CREEM_API_KEY=cr_...
# CREEM_WEBHOOK_SECRET=
# Base API host. Test mode (non-production) defaults to https://test-api.creem.io,
# production to https://api.creem.io — override only for an API relay/proxy
# or a local fake in tests.
# CREEM_BASE_URL=
# Fixed top-up packs as a JSON array. Each entry must map a Creem product id to
# the credits it grants (optional display price in USD cents + label):
#   [{"productId":"prod_...","credits":10000,"label":"10,000 credits","priceCents":500}]
# Leave empty [] to hide the Creem checkout surface in the dashboard.
CREEM_TOPUP_PACKS=[]

# ── Email deliverability ──────────────────────────────────────────────
# Public origin used to render email tracking links/pixels (open/click/unsubscribe).
# Set to the externally reachable base URL of this deployment.
PUBLIC_BASE_URL="http://localhost:3000"
# Per-inbox email config (stored on the connect account):
#   dailyLimit:        int  — cap on sends per UTC day (default 60)
#   minIntervalSeconds:int  — floor between sequential sends (default 45)
